# Select the coding agent adapter. MCP tasks always run without code review.
QUANT_MCP_AGENT=pi
SMOLAGENTS_MODEL_TIMEOUT_SECONDS=120
SMOLAGENTS_MAX_STEPS=8

# Pi executable and model routing.
PI_EXECUTABLE=pi
PI_PROVIDER=deepseek
PI_MODEL=v4flash
PI_THINKING=off

# Optional. Leave blank if Pi already has auth configured.
PI_API_KEY=

# Optional. Leave blank for Pi's default ephemeral session behavior.
PI_SESSION_DIR=

# smolagents / DeepSeek settings (used when QUANT_MCP_AGENT=smolagents).
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_THINKING=disabled
DEEPSEEK_API_BASE=https://api.deepseek.com
DEEPSEEK_API_KEY=

# Preferred: copy codebases.example.yaml to codebases.yaml, edit it, then enable:
# QUANT_MCP_CODEBASES_FILE=codebases.yaml
# This YAML supports multiple external repositories. Its paths are resolved from
# the YAML file. It replaces the legacy settings below when set.

# Legacy single-repository configuration. Blank/unset defaults to this project.
# QUANT_MCP_REPO_ROOT=/absolute/path/to/repository
QUANT_MCP_LIBRARY_MODULES=quant_mcp.pricing
PI_EXECUTION_TIMEOUT_SECONDS=60
PI_MAX_EXECUTIONS=8
