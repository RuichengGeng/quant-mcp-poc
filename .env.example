# Coding-agent limits. Functions are registered in your application with app.expose().
SMOLAGENTS_MODEL_TIMEOUT_SECONDS=120
SMOLAGENTS_MAX_STEPS=12
SMOLAGENTS_PLANNING_INTERVAL=3
SMOLAGENTS_MAX_TOOL_CALLS=100

# For another compatible model endpoint, set these; non-empty values override DEEPSEEK_*.
# SMOLAGENTS_API_KEY=
# SMOLAGENTS_API_BASE=https://your-approved-endpoint/v1
# SMOLAGENTS_MODEL_ID=your-model-id

# Default provider settings. Keep actual credentials in .env or the server environment.
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_THINKING=disabled
DEEPSEEK_API_BASE=https://api.deepseek.com
DEEPSEEK_API_KEY=
