{
  "expected_tools": [
    "price_option_t",
    "calc_greeks_t"
  ],
  "tool_contracts": {
    "price_option_t": {
      "required": [
        "option_type",
        "spot",
        "strike",
        "time_to_expiry",
        "volatility",
        "rate"
      ],
      "properties": {
        "option_type": {
          "type": "string",
          "enum": ["call", "put"]
        },
        "spot": {"type": "number"},
        "volatility": {"type": "number"}
      },
      "read_only": true
    },
    "calc_greeks_t": {
      "required": [
        "option_type",
        "spot",
        "strike",
        "time_to_expiry",
        "volatility",
        "rate"
      ],
      "read_only": true
    }
  },
  "cases": [
    {
      "id": "price-at-the-money-call",
      "tool": "price_option_t",
      "arguments": {
        "option_type": "call",
        "spot": 100,
        "strike": 100,
        "time_to_expiry": 1,
        "volatility": 0.2,
        "rate": 0.05,
        "dividend_yield": 0
      },
      "assertions": {
        "not_error": true,
        "structured_content": {
          "result": {
            "approximately": 10.4506,
            "tolerance": 0.01
          }
        }
      }
    },
    {
      "id": "calculate-call-greeks",
      "tool": "calc_greeks_t",
      "arguments": {
        "option_type": "call",
        "spot": 100,
        "strike": 100,
        "time_to_expiry": 1,
        "volatility": 0.2,
        "rate": 0.05,
        "dividend_yield": 0
      },
      "assertions": {
        "not_error": true,
        "structured_content": {
          "delta": {
            "approximately": 0.6368,
            "tolerance": 0.01
          }
        }
      }
    },
    {
      "id": "reject-negative-volatility",
      "tool": "price_option_t",
      "arguments": {
        "option_type": "call",
        "spot": 100,
        "strike": 100,
        "time_to_expiry": 1,
        "volatility": -0.2,
        "rate": 0.05,
        "dividend_yield": 0
      },
      "assertions": {
        "is_error": true,
        "error_contains": ["Error executing tool"]
      }
    },
    {
      "id": "parallel-pricing-calls",
      "type": "concurrent_tool",
      "tool": "price_option_t",
      "requests": 3,
      "max_concurrency": 2,
      "arguments": {
        "option_type": "call",
        "spot": 100,
        "strike": 100,
        "time_to_expiry": 1,
        "volatility": 0.2,
        "rate": 0.05,
        "dividend_yield": 0
      },
      "assertions": {
        "not_error": true
      }
    },
    {
      "id": "unsupported-weather-question",
      "type": "prompt",
      "prompt": "What's the weather in Singapore?",
      "replay": {
        "response": "I cannot answer weather questions because live weather data is unavailable.",
        "tool_calls": []
      },
      "assertions": {
        "expected_tool_calls": [],
        "response_policy": "refuse_or_explain",
        "response_contains_any": [
          "weather",
          "live data"
        ]
      }
    }
  ]
}
